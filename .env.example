# Copy to `.env` and fill in. `src/db/prisma.ts` refers to this file by name.
# Never commit the real `.env` — it is gitignored.

# ─── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# The bot registers its slash commands on every startup. Set a guild ID here
# for instant registration while developing; leave empty to register globally,
# which can take up to an hour to appear.
DEV_GUILD_ID=

# ─── Database ─────────────────────────────────────────────────────────────────
# IMPORTANT: inside Docker Compose the host is the service name `postgres`,
# NOT `localhost`. `localhost` from inside the bot container resolves to the
# bot container itself and the connection is refused.
#
#   docker compose:  postgresql://bot:botpass@postgres:5432/tracen_academy
#   local dev:       postgresql://bot:botpass@localhost:5432/tracen_academy
DATABASE_URL=postgresql://bot:botpass@postgres:5432/tracen_academy

# ─── Roles ────────────────────────────────────────────────────────────────────
# Comma-separated role IDs allowed to manage clubs (Club Managers).
OFFICER_ROLE_IDS=
# Comma-separated role IDs treated as club roles by `/role`.
CLUB_ROLE_IDS=
# Role applied when a member has no club role (e.g. Tracen Applicant).
DEFAULT_ROLE_ID=

# Pinged when a forum thread is opened with the matching tier tag.
COMP_COUNCIL_ROLE_ID=
SEMI_COMP_COUNCIL_ROLE_ID=
CASUAL_COUNCIL_ROLE_ID=

# ─── Forum ────────────────────────────────────────────────────────────────────
# Forum channel watched for new club-search threads.
FORUM_CHANNEL_ID=
# Forum tag IDs offered by `/settag`.
TAG_TRANSFER_ID=
TAG_CLUB_APP_ACCEPTED_ID=

# ─── uma.moe API ──────────────────────────────────────────────────────────────
# Circle and ranking endpoints reject unauthenticated callers with
# 403 browser_proof_required. Generate a key from your uma.moe account and put
# it here; it is sent as the `X-API-Key` header.
EXTERNAL_API_BASE_URL=https://uma.moe
EXTERNAL_API_KEY=

# ─── Training timer ───────────────────────────────────────────────────────────
# IANA timezone used to decide which calendar day a completed run belongs to,
# which defines daily counts and streaks. Defaults to the game's JST reset.
TIMER_STREAK_TIMEZONE=Asia/Tokyo

# ─── Dashboard ────────────────────────────────────────────────────────────────
# The dashboard runs inside the bot process. Leave these blank to disable it.
#
# DISCORD_CLIENT_SECRET is the OAuth2 "Client Secret" from the Discord
# developer portal (OAuth2 page). It is NOT the bot token -- a different value
# from the same application. Add "<DASHBOARD_BASE_URL>/auth/callback" to that
# application's OAuth2 redirect URIs.
DISCORD_CLIENT_SECRET=
# Public URL the dashboard is served on, no trailing slash.
# On Railway leave this blank: it is derived from RAILWAY_PUBLIC_DOMAIN.
# Set it only for a custom domain, or for local development.
DASHBOARD_BASE_URL=http://localhost:3000
# OPTIONAL. Signing key for dashboard session cookies. Leave blank: the bot
# derives one from DISCORD_TOKEN, which is already secret. Set it only if you
# want sessions to survive a bot-token rotation. At least 32 characters if set.
DASHBOARD_SESSION_SECRET=
# OPTIONAL. Guild whose roles decide dashboard access. Falls back to
# DEV_GUILD_ID, so a single-server bot does not need to set it. Members can
# read; only OFFICER_ROLE_IDS holders can change anything.
DASHBOARD_GUILD_ID=
# Local port. Hosting platforms inject PORT instead, which takes precedence.
DASHBOARD_PORT=3000

# ─── Fan sync schedule ────────────────────────────────────────────────────────
# UTC hour for the daily uma.moe pull. Defaults to 13, an hour after the
# 12:00 GMT refresh seen in uma.moe's own last_updated timestamps.
FAN_SYNC_HOUR_UTC=13
