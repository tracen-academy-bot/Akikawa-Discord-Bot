datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum ClubRank {
    B
    B_PLUS
    A
    A_PLUS
    S
    S_PLUS
}

enum ClubMemberRole {
    TRAINER
    ASSISTANT
}

enum FanCountPeriod {
    DAY
    WEEK
    BIWEEKLY
    MONTH
}

model Club {
    id             String           @id @default(cuid())
    name           String           @unique
    rank           ClubRank
    headcount      Int              @default(0)
    fanCountAmount Float?
    fanCountPeriod FanCountPeriod?
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    members        ClubMember[]
    trackedCircles TrackedCircle[]
}

model ClubMember {
    id            String         @id @default(cuid())
    club          Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
    clubId        String
    discordUserId String
    role          ClubMemberRole
    createdAt     DateTime       @default(now())

    @@unique([clubId, discordUserId])
}

// ─── Independent Training timer ───────────────────────────────────────────────

/// An in-flight 50-minute Independent Training run.
///
/// Timers live in the database rather than in memory so that a restart, a
/// deploy, or the bot being offline cannot silently drop them. On boot the
/// scheduler reloads every row; anything already past `expiresAt` fires
/// immediately instead of being discarded.
model TrainingTimer {
    id             String   @id @default(cuid())
    guildId        String
    /// Channel holding the control panel, where the expiry ping is posted.
    channelId      String
    /// Panel message to refresh when this timer starts or ends.
    panelMessageId String?
    discordUserId  String
    startedAt      DateTime @default(now())
    expiresAt      DateTime

    /// One active timer per trainer per guild. Pressing Start again resets the
    /// existing row rather than stacking a second countdown.
    @@unique([guildId, discordUserId])
    @@index([expiresAt])
}

/// A completed run, kept for statistics and leaderboards.
///
/// Written when the timer reaches zero, keyed on the scheduled `completedAt`
/// rather than the moment the ping was delivered, so downtime does not distort
/// streaks or daily counts.
model TrainingRun {
    id            String   @id @default(cuid())
    guildId       String
    discordUserId String
    startedAt     DateTime
    completedAt   DateTime
    /// Seconds between expiry and ping delivery. Non-zero only when the bot was
    /// down or lagging at expiry; useful for spotting delivery problems.
    deliveryLagS  Int      @default(0)

    @@index([guildId, discordUserId])
    @@index([guildId, completedAt])
}

/// An expiry ping awaiting automatic deletion.
///
/// Held separately from TrainingTimer so a trainer can start their next run the
/// instant they are pinged, rather than waiting out the notification's lifetime.
model TimerNotification {
    id        String   @id @default(cuid())
    channelId String
    messageId String
    deleteAt  DateTime

    @@index([deleteAt])
}

// ─── uma.moe fan tracking ─────────────────────────────────────────────────────

/// A uma.moe circle this server tracks.
///
/// Fan counts are BigInt because the API returns int64. They are converted to
/// JS numbers only at the presentation boundary, via `toSafeNumber`, which
/// asserts the value is below Number.MAX_SAFE_INTEGER.
model TrackedCircle {
    id              String    @id @default(cuid())
    guildId         String
    /// uma.moe `circle_id`.
    circleId        BigInt
    name            String
    /// Optional link to an internal Club record.
    clubId          String?
    /// Fans each member is expected to earn per month.
    monthlyQuota    BigInt    @default(0)
    /// Where scheduled reports are posted. May be a thread.
    reportChannelId String?
    /// Where behind-quota alerts are posted. May be a thread.
    alertChannelId  String?
    /// uma.moe monthly rank at the last sync. Shown in report headers.
    monthlyRank     Int?
    /// Paused circles are kept but skipped by the sync job.
    active          Boolean   @default(true)
    lastSyncedAt    DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    club      Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
    snapshots FanSnapshot[]

    @@unique([guildId, circleId])
    @@index([active])
}

/// Links a Discord account to a uma.moe trainer.
///
/// Lets `/trainer` default to the caller and lets alerts mention a real user
/// rather than printing a bare viewer ID.
model TrainerLink {
    id            String   @id @default(cuid())
    guildId       String
    discordUserId String
    /// uma.moe `viewer_id`.
    viewerId      BigInt
    trainerName   String?
    createdAt     DateTime @default(now())

    @@unique([guildId, discordUserId])
    @@unique([guildId, viewerId])
}

/// One member's cumulative fan total on one game day.
///
/// Mirrors a single element of the API's 31-element `daily_fans` array. Storing
/// one row per day keeps the sync idempotent: re-running it for a day simply
/// overwrites that day rather than appending a duplicate.
model FanSnapshot {
    id             String   @id @default(cuid())
    trackedCircleId String
    viewerId       BigInt
    trainerName    String?
    year           Int
    month          Int
    /// Day of the game month, 1-31.
    day            Int
    /// Cumulative fans at the end of that day, as reported by uma.moe.
    cumulativeFans BigInt
    shameScore     Int?
    /// uma.moe's transfer signals for this member-month. A member who moved
    /// in mid-month carries the circle they came from; these are what settle
    /// how many days of quota a late joiner owes (see docs/quota-math.md).
    previousCircleId   BigInt?
    previousCircleName String?
    nextMonthStart     BigInt?
    recordedAt     DateTime @default(now())

    circle TrackedCircle @relation(fields: [trackedCircleId], references: [id], onDelete: Cascade)

    @@unique([trackedCircleId, viewerId, year, month, day])
    @@index([trackedCircleId, year, month])
    @@index([viewerId])
}

/// Daily fans-per-member-per-day figures at the top-N circle cutoffs.
///
/// uma.moe exposes only current circle totals, not their history, so the
/// benchmark chart is built from snapshots this bot accumulates. History
/// therefore starts from the first sync rather than from the start of time.
model BenchmarkSnapshot {
    id         String   @id @default(cuid())
    year       Int
    month      Int
    day        Int
    /// Cutoff size: 10, 30 or 100.
    tier       Int
    /// Value of the circle sitting exactly on the cutoff.
    entryValue BigInt
    /// Mean across every circle above the cutoff.
    avgValue   BigInt
    recordedAt DateTime @default(now())

    @@unique([year, month, day, tier])
    @@index([year, month])
}

/// Last successful run of a named scheduled job.
///
/// Lets the daily sync stay idempotent across restarts: the job checks whether
/// it has already run for the current day before syncing and posting, so a
/// container restart cannot post the same report twice.
model JobRun {
    /// Job name, e.g. "daily-fan-sync".
    id        String   @id
    lastRunAt DateTime
    /// Short outcome summary, for operators reading the table directly.
    note      String?
}
