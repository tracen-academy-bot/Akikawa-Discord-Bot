  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test:timer": "ts-node --compilerOptions {\"module\":\"commonjs\",\"types\":[\"node\"]} scripts/test-timer.ts",
    "test:scheduler": "ts-node --compilerOptions {\"module\":\"commonjs\",\"types\":[\"node\"]} scripts/test-scheduler.ts",
    "test": "npm run test:metrics && npm run test:timer && npm run test:scheduler",
    "test:metrics": "ts-node --compilerOptions {\"module\":\"commonjs\",\"types\":[\"node\"]} scripts/test-metrics.ts"
  },
