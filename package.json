    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "ioredis": "^6.0.0",
    "prisma": "^6.19.3",
    "@napi-rs/canvas": "^0.1.53"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
